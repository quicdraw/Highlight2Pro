from docx import Document
from docx.enum.text import WD_COLOR_INDEX
import argparse
from pathlib import Path


def extract_highlights(docx_path: str, output_path: str = None, color: WD_COLOR_INDEX = None):
    """
    Extract highlighted text from a Word document and optionally save to a file.
    
    Args:
        docx_path: Path to the input .docx file
        output_path: Path to save the highlights (if None, only returns the list)
        color: Specific highlight color to extract (e.g. WD_COLOR_INDEX.YELLOW). 
               If None, extracts any highlighted text.
    """
    doc = Document(docx_path)
    highlights = []
    current_highlight = ""

    for para in doc.paragraphs:
        for run in para.runs:
            # Check if this run is highlighted (and matches desired color if specified)
            if run.font.highlight_color and (color is None or run.font.highlight_color == color):
                current_highlight += run.text
            elif current_highlight:
                cleaned = current_highlight.strip()
                if cleaned:  # Only add non-empty highlights
                    highlights.append(cleaned)
                current_highlight = ""

    # Don't forget the last highlight
    if current_highlight:
        cleaned = current_highlight.strip()
        if cleaned:
            highlights.append(cleaned)

    # Save to file if output_path is provided
    if output_path and highlights:
        output_path = Path(output_path)
        output_path.parent.mkdir(parents=True, exist_ok=True)
        
        # Save as plain text (one highlight per line) - very clean for ProPresenter
        with open(output_path, "w", encoding="utf-8") as f:
            for i, highlight in enumerate(highlights, 1):
                f.write(f"{highlight}\n\n")  # Double newline for nice separation

        print(f"✅ Saved {len(highlights)} highlights to: {output_path}")
    
    return highlights


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Extract highlighted text from Word document")
    parser.add_argument("input", help="Path to the input .docx file")
    parser.add_argument("-o", "--output", help="Output file path (default: highlights.txt next to input)")
    parser.add_argument("--color", type=str, choices=["yellow", "green", "blue", "pink", "none"],
                        default="none", help="Specific color to extract (default: any highlight)")
    
    args = parser.parse_args()
    
    # Map string to WD_COLOR_INDEX if needed
    color_map = {
        "yellow": WD_COLOR_INDEX.YELLOW,
        "green": WD_COLOR_INDEX.BRIGHT_GREEN,
        "blue": WD_COLOR_INDEX.BLUE,
        "pink": WD_COLOR_INDEX.PINK,
    }
    
    color_filter = color_map.get(args.color) if args.color != "none" else None
    
    if not args.output:
        input_path = Path(args.input)
        args.output = input_path.parent / f"{input_path.stem}_highlights.txt"
    
    highlights = extract_highlights(args.input, args.output, color_filter)
    
    print(f"\nExtracted {len(highlights)} highlight(s):")
    for i, h in enumerate(highlights[:5], 1):   # Show first 5 only
        print(f"{i}. {h[:80]}{'...' if len(h) > 80 else ''}")
    if len(highlights) > 5:
        print(f"... and {len(highlights)-5} more")